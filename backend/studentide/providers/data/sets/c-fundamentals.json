   "solution": "#include <stdio.h>\n\nint is_prime(int n) {\n    if (n < 2) return 0;\n    for (int i = 2; i * i <= n; i++)\n        if (n % i == 0) return 0;\n    return 1;\n}\n\nint main(void) {\n    int t, n;\n    scanf(\"%d\", &t);\n    while (t--) {\n        scanf(\"%d\", &n);\n        printf(is_prime(n) ? \"PRIME\\n\" : \"NOT PRIME\\n\");\n    }\n    return 0;\n}\n"
  }
