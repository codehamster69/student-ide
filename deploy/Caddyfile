# HTTPS in front of Scribelab. Caddy gets and renews a Let's Encrypt certificate
# for each domain by itself: their DNS A records must point at this VM and
# ports 80 and 443 must be open.
{
	email {$ACME_EMAIL}
}

(app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Google's sign-in popup needs to talk back to this page
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Permissions-Policy "camera=(), microphone=(), geolocation=(), display-capture=()"
		-Server
	}
	request_body {
		max_size 4MB
	}
	reverse_proxy app:8000
}

{$STUDENTIDE_DOMAIN} {
	import app
}

# Addresses from before the rename (STUDENTIDE_OLD_DOMAINS, space separated,
# e.g. studentide.hokora.xyz). People's browsers are sent to the new address;
# desktop apps from before the rename (locked to the old origin until they
# update) and API callers are still served here, so nothing breaks mid-update.
# Unset, this block only answers plain HTTP for a name that never resolves.
{$STUDENTIDE_OLD_DOMAINS:http://renamed.invalid} {
	@stay {
		header User-Agent *StudentIDE-Desktop*
	}
	@api path /api/*
	handle @stay {
		import app
	}
	handle @api {
		import app
	}
	handle {
		redir https://{$STUDENTIDE_DOMAIN}{uri} 308
	}
}
