# Copy to deploy/.env and fill in. deploy/.env is git-ignored: never commit it.

# Public name of the site, e.g. studentide.iiitsurat.ac.in or a domain you own.
STUDENTIDE_DOMAIN=studentide.example.in
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@iiitsurat.ac.in

# Google OAuth client (Web application) from console.cloud.google.com, see docs/deploy.md.
# Setting it turns on Google sign-in and turns off roll-number sign-in.
STUDENTIDE_GOOGLE_CLIENT_ID=123456789012-abcdefg.apps.googleusercontent.com
STUDENTIDE_ALLOWED_DOMAIN=iiitsurat.ac.in

# Always admins (comma-separated). Admins promote teachers and TAs on the People page.
STUDENTIDE_ADMINS=pg25cs07@iiitsurat.ac.in

# Optional: only these branch codes count as student addresses (any 2-4 letters when empty).
STUDENTIDE_BRANCH_CODES=

# Raw keystrokes: deleted once a student's 4-week baseline is built, and from any
# session older than this many days. Purging is on in Google mode; off only with STUDENTIDE_PURGE=off.
STUDENTIDE_RAW_KEY_DAYS=28

# Sign-in lasts this many days.
STUDENTIDE_SESSION_DAYS=7

# Leave empty in production: teachers sign in with Google. Set only for scripts, then unset.
STUDENTIDE_ADMIN_TOKEN=

BACKUP_KEEP_DAYS=14
